# Trading Eyes — environment. Copy to .env and fill in. NEVER commit .env.
# ============== REQUIRED: OANDA practice account (free at oanda.com) ==============
OANDA_API_URL=https://api-fxpractice.oanda.com
OANDA_API_KEY=your-practice-api-token-here
OANDA_ACCOUNT_ID=your-practice-account-id-here
# ============== OPTIONAL: Coinbase Advanced (REAL MONEY — see knowledge/COINBASE_NOTES.md) ==============
# Disabled until you complete the onboarding step that explicitly enables it.
#COINBASE_ADV_KEY_NAME=
#COINBASE_ADV_PRIVATE_KEY=
